---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf()
).slice(0, 3);
---

<BaseLayout
  title="Cho Thuê Xe Tự Lái VinFast Limo Green Hà Nội – Hợp Đồng Dài Hạn 3-5 Năm"
  description="Dịch vụ cho thuê xe VinFast Limo Green 7 chỗ tự lái tại Hà Nội. Thuê xe điện tự lái tiết kiệm 100% chi phí xăng dầu, hợp đồng dài hạn giá tốt nhất."
  currentPath="/"
>
  <Fragment slot="head">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
    
    <!-- Schema: Service -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "Service",
      "serviceType": "Thuê xe 7 chỗ tự lái VinFast Limo Green",
      "provider": { "@type": "LocalBusiness", "name": "VinFast Limo Green Hà Nội" },
      "areaServed": { "@type": "State", "name": "Hà Nội" },
      "hasOfferCatalog": { "@type": "OfferCatalog", "name": "Dịch vụ thuê xe điện tự lái",
        "itemListElement": [{ "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Thuê xe VinFast Limo Green tự lái" }, "price": "21600000", "priceCurrency": "VND" }]
      }
    })} />

    <!-- Schema: LocalBusiness -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "LocalBusiness",
      "name": "VinFast Limo Green Hà Nội",
      "image": "https://limogreen.chothuexe.vip/images/branding/limo_green_final.png",
      "@id": "https://limogreen.chothuexe.vip", "url": "https://limogreen.chothuexe.vip",
      "telephone": "+84979121097",
      "address": { "@type": "PostalAddress", "streetAddress": "Hà Nội", "addressLocality": "Hà Nội", "postalCode": "100000", "addressCountry": "VN" },
      "geo": { "@type": "GeoCoordinates", "latitude": 21.028511, "longitude": 105.804817 },
      "openingHoursSpecification": { "@type": "OpeningHoursSpecification", "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday","Sunday"], "opens": "06:00", "closes": "22:00" },
      "sameAs": ["https://zalo.me/0979121097"]
    })} />

    <!-- Schema: FAQPage -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "FAQPage",
      "mainEntity": [
        { "@type": "Question", "name": "Chi phí bảo trì, bảo dưỡng định kỳ ai chịu trách nhiệm?", "acceptedAnswer": { "@type": "Answer", "text": "Xe được bảo dưỡng định kỳ theo tiêu chuẩn hãng. Người thuê có trách nhiệm bắt buộc đưa xe đi bảo dưỡng đúng lịch của VinFast (mỗi 5.000km hoặc 6 tháng)." }},
        { "@type": "Question", "name": "Nếu xe bị hỏng hóc hoặc gặp sự cố kỹ thuật thì xử lý thế nào?", "acceptedAnswer": { "@type": "Answer", "text": "Các lỗi kỹ thuật nằm trong danh mục bảo hành của VinFast sẽ được hãng xử lý miễn phí. Các hư hại do cách vận hành sai người thuê hoàn toàn chịu trách nhiệm chi phí sửa chữa." }},
        { "@type": "Question", "name": "Mỗi tháng tôi được chạy tối đa bao nhiêu km?", "acceptedAnswer": { "@type": "Answer", "text": "Định mức 3,500km/tháng. Nếu chạy vượt định mức, phí phụ trội là 3.000đ/km." }},
        { "@type": "Question", "name": "Tôi có được cho người khác mượn hoặc thuê lại xe không?", "acceptedAnswer": { "@type": "Answer", "text": "Tuyệt đối KHÔNG. Hợp đồng chỉ ký cho người thuê trực tiếp sử dụng." }}
      ]
    })} />

    <!-- Schema: BreadcrumbList -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org", "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Trang Chủ", "item": "https://limogreen.chothuexe.vip/" },
        { "@type": "ListItem", "position": 2, "name": "Kinh Doanh Xe Điện", "item": "https://limogreen.chothuexe.vip/#mo-hinh-kinh-doanh" },
        { "@type": "ListItem", "position": 3, "name": "Giá Thuê Xe", "item": "https://limogreen.chothuexe.vip/#gia-thue" },
        { "@type": "ListItem", "position": 4, "name": "Đăng Ký Thuê Xe", "item": "https://limogreen.chothuexe.vip/#lien-he" }
      ]
    })} />

    <style>
      .cost-bar { background: linear-gradient(90deg, #ef4444, #dc2626); }
      .savings-bar { background: linear-gradient(90deg, #00A859, #00D46A); }
    </style>
  </Fragment>

  <iframe name="hidden_iframe" id="hidden_iframe" style="display:none;" title="form-submit"></iframe>

  <section class="hero-bg" id="trang-chu">
    <!-- Background Image Slider (absolute, fills entire section) -->
    <div class="swiper hero-swiper absolute inset-0 w-full h-full z-0">
      <div class="swiper-wrapper">
        <div class="swiper-slide">
          <img src="/images/hero/hero-1.jpg" class="w-full h-full object-cover"
            alt="Thuê xe tự lái VinFast Limo Green Hà Nội - Xe 7 chỗ hiện đại" loading="eager">
        </div>
        <div class="swiper-slide">
          <img src="/images/hero/hero-2.jpg" class="w-full h-full object-cover"
            alt="Thuê xe 7 chỗ tự lái VinFast Limo Green - Xe điện tiết kiệm" loading="lazy">
        </div>
        <div class="swiper-slide">
          <img src="/images/hero/hero-3.jpg" class="w-full h-full object-cover"
            alt="Thuê xe điện tự lái VinFast Limo Green - Giải pháp vận tải xanh" loading="lazy">
        </div>
      </div>
    </div>

    <!-- Dark overlay for text readability -->
    <div class="hero-overlay"></div>

    <!-- Content Layer (overlays on top of the slider) -->
    <div class="relative z-10 flex items-center min-h-screen w-full">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 py-24 sm:py-32 md:py-40 w-full">
        <div class="max-w-2xl lg:max-w-3xl" data-aos="fade-up">

          <!-- Badge row -->
          <div class="flex flex-wrap gap-2 mb-5 sm:mb-6">
            <span class="bg-primary/20 border border-primary/50 text-green-300 text-xs font-semibold px-3 py-1 rounded-full">⚡ Xe Điện 7 Chỗ</span>
            <span class="bg-gold/20 border border-gold/50 text-yellow-300 text-xs font-semibold px-3 py-1 rounded-full">⛽ Chi Phí Xăng Dầu: 0đ</span>
            <span class="bg-white/10 border border-white/30 text-white/80 text-xs font-semibold px-3 py-1 rounded-full">📋 Hợp Đồng 3-5 Năm</span>
          </div>

          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black text-white leading-tight mb-4">
            Cho Thuê Xe Tự Lái<br>
            <span class="text-gradient">VinFast Limo Green</span><br>
            <span class="text-white">Kiếm Tiền Mỗi Ngày</span>
          </h1>

          <p class="text-white/80 text-base sm:text-lg md:text-xl mb-2 font-medium">
            Xe điện 7 chỗ VinFast Limo Green · Biển trắng · Hà Nội
          </p>
          <p class="text-white/60 text-sm sm:text-base mb-6">
            Chủ động kinh doanh vận tải · Không qua app · Không mất hoa hồng · Ổn định lâu dài
          </p>

          <!-- ZERO FUEL + Price highlight - stack on mobile, inline on desktop -->
          <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 mb-6 sm:mb-8">
            <div class="bg-gradient-to-r from-amber-500/20 to-yellow-400/10 border-2 border-yellow-400/60 rounded-2xl p-4 sm:p-5">
              <div class="flex items-center gap-3">
                <div class="text-3xl sm:text-4xl">⛽</div>
                <div>
                  <div class="text-yellow-300 font-black text-lg sm:text-xl leading-tight">Chi phí nhiên liệu: <span class="text-white text-2xl sm:text-3xl">0đ</span></div>
                  <div class="text-yellow-200/80 text-xs sm:text-sm mt-0.5">Sạc điện miễn phí đến hết 30/06/2027</div>
                </div>
              </div>
            </div>

            <div class="bg-white/10 backdrop-blur-sm border border-white/20 rounded-2xl p-4 sm:p-5">
              <div class="flex items-baseline gap-2">
                <span class="text-4xl sm:text-5xl font-black text-white">24</span>
                <span class="text-xl sm:text-2xl font-bold text-white">triệu</span>
                <span class="text-white/60 text-base sm:text-lg">/tháng</span>
              </div>
              <div class="text-green-300 text-xs sm:text-sm mt-1 font-medium">Tất cả chi phí vận hành</div>
            </div>
          </div>

          <!-- CTA buttons -->
          <div class="flex flex-col sm:flex-row gap-3">
            <a href="#lien-he"
              class="bg-primary hover:bg-primary-dark text-white font-bold text-base px-7 py-3.5 rounded-xl transition-all hover:-translate-y-0.5 hover:shadow-lg hover:shadow-primary/40 text-center">
              Liên Hệ Thuê Xe →
            </a>
            <a href="#mo-hinh-kinh-doanh"
              class="bg-white/10 hover:bg-white/20 border border-white/30 text-white font-semibold text-base px-7 py-3.5 rounded-xl transition-all text-center">
              Xem Cách Kiếm Tiền ↓
            </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-6 sm:bottom-8 left-1/2 -translate-x-1/2 text-white/50 text-xs text-center animate-bounce z-20">
      <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24" class="mx-auto">
        <path d="M7 10l5 5 5-5" />
      </svg>
    </div>
  </section>
  <section class="bg-dark py-12 px-4 shadow-inner">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
        <div class="text-center" data-aos="fade-up" data-aos-delay="0">
          <div class="text-primary text-3xl mb-2">⚡</div>
          <div class="text-white font-black text-2xl">150 kW</div>
          <div class="text-gray-500 text-xs uppercase tracking-widest">Công Suất Cực Đại</div>
        </div>
        <div class="text-center" data-aos="fade-up" data-aos-delay="100">
          <div class="text-primary text-3xl mb-2">🌀</div>
          <div class="text-white font-black text-2xl">400 Nm</div>
          <div class="text-gray-500 text-xs uppercase tracking-widest">Mô-men Xoắn</div>
        </div>
        <div class="text-center" data-aos="fade-up" data-aos-delay="200">
          <div class="text-primary text-3xl mb-2">🔋</div>
          <div class="text-white font-black text-2xl">450 km</div>
          <div class="text-gray-500 text-xs uppercase tracking-widest">Quãng Đường / Sạc</div>
        </div>
        <div class="text-center" data-aos="fade-up" data-aos-delay="300">
          <div class="text-primary text-3xl mb-2">📏</div>
          <div class="text-white font-black text-2xl">2.767 mm</div>
          <div class="text-gray-500 text-xs uppercase tracking-widest">Chiều Dài Cơ Sở</div>
        </div>
      </div>
    </div>
  </section>
  <section class="bg-gradient-to-r from-amber-500 via-yellow-400 to-amber-500 py-6 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col md:flex-row items-center justify-center gap-4 text-center md:text-left mb-3">
        <div class="text-4xl">⛽</div>
        <div>
          <div class="font-black text-gray-900 text-xl md:text-2xl">CHI PHÍ NHIÊN LIỆU BẰNG 0 KHI KINH DOANH BẰNG XE
            ĐIỆN</div>
          <div class="font-semibold text-gray-800 text-sm mt-1">Sạc điện hoàn toàn miễn phí tại 2,221+ trạm V-Green toàn
            quốc — đến hết <strong>30/06/2027</strong></div>
        </div>
        <div
          class="bg-gray-900 text-yellow-400 font-black text-sm px-5 py-2 rounded-full whitespace-nowrap flex-shrink-0">
          Tiết kiệm 7-8tr/tháng ⚡
        </div>
      </div>
      <div class="grid grid-cols-3 gap-3 max-w-xl mx-auto mt-2">
        <div class="bg-black/20 rounded-xl py-2 text-center">
          <div class="font-black text-gray-900 text-lg">0đ</div>
          <div class="text-gray-800 text-xs">Tiền xăng/tháng</div>
        </div>
        <div class="bg-black/20 rounded-xl py-2 text-center">
          <div class="font-black text-gray-900 text-lg">2,221+</div>
          <div class="text-gray-800 text-xs">Trạm sạc V-Green</div>
        </div>
        <div class="bg-black/20 rounded-xl py-2 text-center">
          <div class="font-black text-gray-900 text-lg">450km</div>
          <div class="text-gray-800 text-xs">Mỗi lần sạc</div>
        </div>
      </div>
    </div>
  </section>
  <section class="py-16 px-4 bg-white" id="so-sanh-chi-phi">
    <div class="max-w-6xl mx-auto">
      <div data-aos="fade-up" class="text-center mb-12">
        <span class="text-primary font-semibold text-sm uppercase tracking-widest">Phân Tích Kinh Tế</span>
        <h2 class="text-3xl md:text-4xl font-black text-dark mt-2">Lợi Thế Tài Chính Từ Xe Điện</h2>
      </div>

      <div class="overflow-x-auto" data-aos="fade-up">
        <table class="w-full border-collapse bg-white rounded-3xl overflow-hidden shadow-sm border border-gray-100">
          <thead>
            <tr class="bg-gray-50 text-dark text-sm uppercase">
              <th class="p-6 text-left border-b border-gray-100">Hạng Mục So Sánh</th>
              <th class="p-6 text-center border-b border-gray-100 bg-red-50/30">Xe Xăng (Innova/7 chỗ)</th>
              <th class="p-6 text-center border-b border-gray-100 bg-primary/5 text-primary">Limo Green (Xe Điện)</th>
            </tr>
          </thead>
          <tbody class="text-sm text-gray-700">
            <tr>
              <td class="p-6 border-b border-gray-50 font-bold">Nhiên liệu (~3.000km/tháng)</td>
              <td class="p-6 border-b border-gray-50 text-center text-red-500">~6.500.000đ - 7.500.000đ</td>
              <td class="p-6 border-b border-gray-50 text-center text-primary font-bold">0đ (Đến 30/06/2027)</td>
            </tr>
            <tr>
              <td class="p-6 border-b border-gray-50 font-bold">Bảo trì & Bảo dưỡng</td>
              <td class="p-6 border-b border-gray-50 text-center">~1.500.000đ/tháng</td>
              <td class="p-6 border-b border-gray-50 text-center font-bold text-primary">Tối thiểu (Rẻ hơn 70%)</td>
            </tr>
            <tr>
              <td class="p-6 border-b border-gray-50 font-bold">Vận hành thực tế</td>
              <td class="p-6 border-b border-gray-50 text-center">Ổn định truyền thống</td>
              <td class="p-6 border-b border-gray-50 text-center">Êm ái, Không mùi, VIP</td>
            </tr>
            <tr>
              <td class="p-6 border-b border-gray-50 font-bold">Hình ảnh thương hiệu</td>
              <td class="p-6 border-b border-gray-50 text-center">Phổ thông</td>
              <td class="p-6 border-b border-gray-50 text-center font-bold text-primary">Đối tác Xanh (ESG Standard)
              </td>
            </tr>
          </tbody>
          <tfoot>
            <tr class="bg-dark text-white">
              <td class="p-6 font-black text-lg text-primary">LỢI NHUẬN GIA TĂNG</td>
              <td class="p-6 text-center opacity-50 text-xs">Cơ bản</td>
              <td class="p-6 text-center text-lg font-black text-primary">⚡ Thêm ~8.000.000đ/tháng</td>
            </tr>
          </tfoot>
        </table>
      </div>

      <!-- Savings callout -->
      <div
        class="mt-10 bg-gradient-to-r from-primary to-primary-dark rounded-3xl p-8 text-white shadow-xl shadow-primary/20"
        data-aos="fade-up">
        <div class="flex flex-col md:flex-row items-center gap-8">
          <div class="flex-1">
            <h3 class="text-2xl font-black mb-2">Tiết Kiệm Lên Đến 100 Triệu/Năm</h3>
            <p class="text-white/80 text-sm">Với xe điện, bạn chuyển toàn bộ chi phí xăng dầu thành lợi nhuận ròng. Đây
              là giải pháp tối ưu cho doanh nhân vận tải năm 2026.</p>
          </div>
          <div class="flex gap-4">
            <div class="bg-white/10 px-6 py-4 rounded-2xl text-center border border-white/20">
              <div class="text-2xl font-black text-yellow-300">420Tr+</div>
              <div class="text-[10px] uppercase opacity-70">5 Năm Hợp Đồng</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="py-20 px-4 bg-gray-50 overflow-hidden" id="doanh-nghiep">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div data-aos="fade-right">
          <span class="text-primary font-bold text-xs uppercase tracking-widest">Tiêu Chuẩn B2B</span>
          <h2 class="text-3xl md:text-5xl font-black text-dark mt-4 mb-6 leading-tight">Đối Tác Vận Tải Xanh<br>Cho
            Doanh Nghiệp</h2>
          <p class="text-gray-600 mb-8 text-lg">
            Limo Green không chỉ là một chiếc xe, đó là chìa khóa để doanh nghiệp của bạn đạt được tiêu chuẩn ESG (Môi
            trường - Xã hội - Quản trị) và tạo ấn tượng mạnh mẽ với đối tác quốc tế.
          </p>
          <ul class="space-y-4">
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 bg-primary/10 rounded-full flex items-center justify-center text-primary mt-1">✓</div>
              <div><strong class="text-dark">Nâng tầm thương hiệu:</strong> Xe điện sang trọng, hiện đại phù hợp đón
                khách VIP, chuyên gia.</div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 bg-primary/10 rounded-full flex items-center justify-center text-primary mt-1">✓</div>
              <div><strong class="text-dark">Giảm phát thải:</strong> Báo cáo cắt giảm carbon thực tế cho các hợp đồng
                FDI.</div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-6 h-6 bg-primary/10 rounded-full flex items-center justify-center text-primary mt-1">✓</div>
              <div><strong class="text-dark">Tối ưu vận hành:</strong> Chi phí nhiên liệu bằng 0 giúp ổn định dòng tiền
                doanh nghiệp.</div>
            </li>
          </ul>
        </div>
        <div class="relative" data-aos="fade-left">
          <div class="absolute -inset-4 bg-primary/10 rounded-full blur-3xl opacity-50"></div>
          <img src="/images/gallery/silver-side.jpg" alt="Giải pháp vận tải xanh cho doanh nghiệp"
            class="relative rounded-3xl shadow-2xl border-8 border-white">
          <div class="absolute -bottom-6 -right-6 bg-dark p-6 rounded-2xl shadow-xl text-white">
            <div class="text-primary font-black text-3xl">70%</div>
            <div class="text-[10px] uppercase tracking-wider text-gray-500">Giảm Chi Phí Vận Hành</div>
          </div>
        </div>
      </div>
    </div>
  </section>
  <section class="py-20 px-4 bg-gray-50" id="mo-hinh-kinh-doanh">
    <div class="max-w-7xl mx-auto">
      <div data-aos="fade-up" class="text-center mb-14">
        <span class="text-primary font-semibold text-sm uppercase tracking-widest">Xe Biển Trắng — Kinh Doanh Gì?</span>
        <h2 class="text-3xl md:text-4xl font-black text-dark mt-2">
          4 Mô Hình Kinh Doanh<br>Hiệu Quả Với Limo Green
        </h2>
        <p class="text-gray-500 mt-3 max-w-xl mx-auto">
          Xe biển trắng <strong>không chạy app Grab/Be</strong> được — nhưng đó không phải điểm yếu.
          Bạn tự chủ lịch trình, tự định giá, <strong>không bị app tính hoa hồng 20-25%</strong>.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">

        <!-- Model 1: School pickup -->
        <div class="biz-card rounded-2xl p-6 card-hover" data-aos="fade-up" data-aos-delay="0">
          <div class="w-14 h-14 bg-blue-100 rounded-2xl flex items-center justify-center text-3xl mb-4">🎒</div>
          <h3 class="font-black text-lg text-dark mb-2">Đưa Đón Học Sinh</h3>
          <p class="text-gray-600 text-sm mb-3">Ký hợp đồng với 2-3 nhóm phụ huynh cùng khu vực. 7 chỗ rộng rãi, điều
            hòa mát, phụ huynh an tâm giao con.</p>
          <div class="bg-yellow-50 border border-yellow-200 rounded-lg px-3 py-2 mb-3 flex items-center gap-2">
