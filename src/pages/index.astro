    // Gallery
    var galleryThumbs = new Swiper('.gallery-thumbs', { spaceBetween: 10, slidesPerView: 4, freeMode: true, watchSlidesProgress: true, breakpoints: { 640: { slidesPerView: 5 }, 1024: { slidesPerView: 6 } } });
    new Swiper('.gallery-main', { spaceBetween: 10, navigation: { nextEl: '.swiper-button-next', prevEl: '.swiper-button-prev' }, thumbs: { swiper: galleryThumbs } });

    // FAQ
    document.querySelectorAll('.faq-trigger').forEach(function(btn) {
      btn.addEventListener('click', function() {
        var item = this.closest('.faq-item');
        document.querySelectorAll('.faq-item').forEach(function(other) {
          if (other !== item) other.classList.remove('open');
        });
        item.classList.toggle('open');
      });
    });

    // Form
    var formSubmitted = false;
    var form = document.getElementById('contactForm') || document.getElementById('contactFormMain');
    if (form) {
      form.addEventListener('submit', function(e) {
        var btn = document.getElementById('submitBtn');
        var btnText = document.getElementById('btnText');
        var spinner = document.getElementById('btnSpinner');
        var emailInput = document.getElementById('emailField');
        if (emailInput && !emailInput.value) emailInput.value = 'khach-lien-he-zalo@gmail.com';
        if (btnText) btnText.textContent = 'Đang gửi thông tin...';
        if (spinner) spinner.classList.remove('hidden');
        if (btn) { btn.disabled = true; btn.style.opacity = '0.7'; }
        formSubmitted = true;
      });
    }

    var hiddenIframe = document.getElementById('hidden_iframe');
    if (hiddenIframe) {
      hiddenIframe.onload = function() {
        if (formSubmitted) {
          var toast = document.getElementById('toast');
          var btnText = document.getElementById('btnText');
          var spinner = document.getElementById('btnSpinner');
          var btn = document.getElementById('submitBtn');
          if (toast) toast.classList.add('show');
          setTimeout(function() { if (toast) toast.classList.remove('show'); }, 2500);
          if (btnText) btnText.textContent = '✅ Gửi thành công!';
          if (spinner) spinner.classList.add('hidden');
          if (btn) btn.style.opacity = '1';
          if (form) form.reset();
          setTimeout(function() {
            if (btnText) btnText.textContent = 'Gửi Đăng Ký Ngay →';
            if (btn) btn.disabled = false;
            window.location.href = 'https://zalo.me/0979121097';
          }, 2000);
          formSubmitted = false;
        }
      };
    }
  </script>
</BaseLayout>
