---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf()
);
---

<BaseLayout
  title="Blog Kiến Thức Thuê Xe Điện VinFast Limo Green – Kinh Nghiệm & Chia Sẻ"
  description="Chia sẻ kinh nghiệm thuê xe điện VinFast Limo Green, so sánh chi phí, hướng dẫn kinh doanh vận tải xe điện. Bài viết hữu ích cho tài xế và doanh nghiệp."
  currentPath="/blog/"
>
  <Fragment slot="head">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet" />
  </Fragment>

  <main class="pt-24">
    <div class="max-w-6xl mx-auto px-4 py-4">
      <nav class="text-sm text-gray-500"><a href="/" class="hover:text-primary">Trang Chủ</a> <span class="mx-2">/</span> <span class="text-dark font-semibold">Blog</span></nav>
    </div>

    <section class="px-4 pb-8">
      <div class="max-w-6xl mx-auto text-center" data-aos="fade-up">
        <span class="text-primary font-semibold text-sm uppercase tracking-widest">Kiến Thức</span>
        <h1 class="text-3xl md:text-5xl font-black text-dark mt-3">Blog Kinh Doanh Xe Điện</h1>
        <p class="text-gray-500 mt-4 max-w-2xl mx-auto">Chia sẻ kinh nghiệm thuê xe, so sánh chi phí, và hướng dẫn kinh doanh vận tải xe điện VinFast Limo Green</p>
      </div>
    </section>

    <section class="py-12 px-4 bg-gray-50">
      <div class="max-w-6xl mx-auto">
        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <a href={`/blog/${post.slug}/`} class="bg-white rounded-2xl overflow-hidden card-hover border border-gray-100 group" data-aos="fade-up">
              {post.data.image && (
                <div class="aspect-video overflow-hidden">
                  <img src={post.data.image} alt={post.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                </div>
              )}
              <div class="p-6">
                <div class="flex flex-wrap items-center gap-2 mb-3">
                  {post.data.tags && post.data.tags.map((tag: string) => (
                    <span class="text-xs bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full">{tag}</span>
                  ))}
                </div>
                <h2 class="font-black text-dark text-lg mb-2 group-hover:text-primary transition-colors leading-snug">{post.data.title}</h2>
                <p class="text-gray-500 text-sm line-clamp-3">{post.data.description}</p>
                <div class="mt-4 text-primary font-semibold text-sm">Đọc tiếp →</div>
              </div>
            </a>
          ))}
        </div>

        {posts.length === 0 && (
          <div class="text-center py-20">
            <div class="text-4xl mb-4">📝</div>
            <p class="text-gray-500">Chưa có bài viết nào. Hãy quay lại sau!</p>
          </div>
        )}
      </div>
    </section>
  </main>

  <script src="https://unpkg.com/aos@2.3.1/dist/aos.js" is:inline></script>
  <script is:inline>AOS.init({ duration: 700, once: true, easing: 'ease-out-cubic' });</script>
</BaseLayout>
