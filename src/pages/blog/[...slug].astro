---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await post.render();

// Process Headings for TOC (Nested Structure)
const nestedHeadings: any[] = [];
headings.filter((h: any) => h.depth <= 3).forEach((h: any) => {
  if (h.depth === 2 || nestedHeadings.length === 0) {
    nestedHeadings.push({ ...h, subHeadings: [] });
  } else {
    nestedHeadings[nestedHeadings.length - 1].subHeadings.push(h);
  }
});

// Recent posts (excluding current post)
const allPosts = await getCollection('blog');
const recentPosts = allPosts
  .sort((a, b) => new Date(b.data.publishDate).valueOf() - new Date(a.data.publishDate).valueOf())
  .filter(p => p.slug !== post.slug)
  .slice(0, 5);

// Estimate reading time
const wordCount = post.body ? post.body.split(/\s+/).length : 500;
const readingTime = Math.ceil(wordCount / 200);
---

<BaseLayout
  title={`${post.data.title} – Limo Green Blog`}
  description={post.data.description}
  image={post.data.image}
  type="article"
  publishDate={post.data.publishDate}
  currentPath={`/blog/${post.slug}/`}
>
  <Fragment slot="head">
    <!-- BlogPosting Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": post.data.title,
      "description": post.data.description,
      "image": post.data.image ? `https://limogreen.chothuexe.vip${post.data.image}` : undefined,
      "datePublished": post.data.publishDate,
      "author": { "@type": "Organization", "name": "Limo Green Hà Nội" },
      "publisher": { "@type": "Organization", "name": "Limo Green Hà Nội", "logo": { "@type": "ImageObject", "url": "https://limogreen.chothuexe.vip/images/branding/limo_green_final.png" } },
      "mainEntityOfPage": { "@type": "WebPage", "@id": `https://limogreen.chothuexe.vip/blog/${post.slug}/` }
    })} />
  </Fragment>

  <main class="pt-[76px] bg-[#FAFAFA]">
    <!-- Article Hero -->
    <article class="pb-20">
      
      <div class="bg-white border-b border-gray-100 mb-8 relative overflow-hidden shadow-sm">
        <div class="absolute inset-0 bg-gradient-to-br from-primary/5 to-transparent pointer-events-none"></div>
        
        <!-- Breadcrumb -->
        <div class="border-b border-gray-50">
          <div class="max-w-[1400px] w-full mx-auto px-4 sm:px-6 md:px-8 py-3">
            <nav class="text-[13px] font-medium flex items-center gap-2 overflow-x-auto whitespace-nowrap text-gray-500">
              <a href="/" class="hover:text-primary transition-colors flex items-center gap-1">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"></path></svg>
                Trang Chủ
              </a>
              <span class="text-gray-300">/</span>
              <a href="/blog/" class="hover:text-primary transition-colors">Blog</a>
              <span class="text-gray-300">/</span>
              <span class="text-dark font-semibold truncate max-w-xs md:max-w-md">{post.data.title}</span>
            </nav>
          </div>
        </div>

        <div class="max-w-[1000px] mx-auto px-4 pt-12 pb-14 relative z-10 text-center">
          <div class="flex flex-wrap justify-center items-center gap-3 mb-6">
            {post.data.tags && post.data.tags.map((tag: string) => (
              <span class="text-[11px] bg-primary/10 border border-primary/20 text-primary px-3 py-1.5 rounded-full font-bold uppercase tracking-wider">{tag}</span>
            ))}
          </div>
          <h1 class="text-3xl md:text-5xl lg:text-[54px] font-black text-dark leading-[1.25] mb-5 tracking-tight">{post.data.title}</h1>
          <p class="text-gray-500 text-lg md:text-xl max-w-4xl mx-auto mb-8 leading-relaxed font-medium">{post.data.description}</p>
          <div class="flex flex-wrap items-center justify-center gap-4 text-[13px] md:text-sm font-semibold text-gray-500">
            <div class="flex items-center gap-2">
              <img src="/images/branding/limo_green_final.png" alt="Limo Green Avatar" class="w-10 h-10 rounded-full object-contain bg-dark p-1 shadow border border-gray-100 flex-shrink-0" />
              <div class="text-left">
                <div class="text-dark">Limo Green</div>
                <div class="text-[11px] font-medium opacity-80 uppercase tracking-widest text-primary">Ban Biên Tập</div>
              </div>
            </div>
            <div class="w-px h-8 bg-gray-200 hidden sm:block"></div>
            <div class="flex items-center gap-2 bg-gray-50 px-4 py-2 rounded-full border border-gray-100">
              <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              <span>{new Date(post.data.publishDate).toLocaleDateString('vi-VN', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
            </div>
            <div class="flex items-center gap-2 bg-yellow-50 px-4 py-2 rounded-full border border-yellow-100 text-yellow-700">
              <svg class="w-4 h-4 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              <span>~{readingTime} phút đọc</span>
            </div>
          </div>
        </div>
      </div>

      <div class="max-w-[1440px] w-full mx-auto px-4 sm:px-6 md:px-8">
        <!-- 3-Column Layout: 20% (TOC) | 60% (Content) | 20% (Recent Posts) -->
        <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 xl:gap-12 items-start">
          
          <!-- LEFT SIDEBAR: Table of Contents (20%) -->
          <aside class="hidden lg:block lg:col-span-1 space-y-8 sticky top-[100px] max-h-[calc(100vh-120px)] overflow-y-auto [&::-webkit-scrollbar]:w-1.5 [&::-webkit-scrollbar-track]:bg-transparent [&::-webkit-scrollbar-thumb]:bg-gray-200 hover:[&::-webkit-scrollbar-thumb]:bg-gray-300 [&::-webkit-scrollbar-thumb]:rounded-full pr-2">
             {nestedHeadings.length > 0 ? (
              <div class="bg-white/80 backdrop-blur-sm border border-gray-100 rounded-[2rem] p-6 shadow-sm">
                <h4 class="font-black text-dark text-base mb-5 flex items-center gap-2 border-b border-gray-100 pb-3">
                  <span class="w-6 h-6 rounded-full bg-primary/10 flex items-center justify-center">
                    <svg class="w-3 h-3 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16"></path></svg>
                  </span>
                  Nội Dung Chính
                </h4>
                <nav class="space-y-1 relative">
                  {nestedHeadings.map((h2) => (
                    <div class="relative">
                      {h2.subHeadings.length > 0 ? (
                        <details class="group" open>
                          <summary class="flex items-start justify-between cursor-pointer list-none [&::-webkit-details-marker]:hidden py-1.5 transition-all">
                            <a href={`#${h2.slug}`} class="block font-bold text-[13px] text-gray-800 hover:text-primary leading-snug flex-1 pr-2">
                              {h2.text}
                            </a>
                            <svg class="w-4 h-4 text-gray-400 group-open:rotate-180 transition-transform mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                          </summary>
                          <div class="ml-2 mt-1 mb-2 space-y-1.5 border-l border-gray-100 pl-3">
                            {h2.subHeadings.map((h3: any) => (
                              <a href={`#${h3.slug}`} class="block transition-all hover:translate-x-1 text-[12px] text-gray-500 hover:text-primary leading-normal py-0.5">
                                {h3.text}
                              </a>
                            ))}
                          </div>
                        </details>
                      ) : (
                        <a href={`#${h2.slug}`} class="block font-bold text-[13px] text-gray-800 hover:text-primary leading-snug py-1.5 transition-all">
                          {h2.text}
                        </a>
                      )}
                    </div>
                  ))}
                </nav>
              </div>
            ) : (
              <div class="text-xs text-gray-400 italic">Không có mục lục nội dung</div>
            )}
          </aside>

          <!-- MIDDLE: Main Content Area (60%) -->
          <div class="lg:col-span-3 min-w-0 bg-white p-5 sm:p-8 md:p-10 lg:p-12 rounded-[1.5rem] sm:rounded-[2.5rem] shadow-sm border border-gray-100 overflow-hidden">
            {post.data.image && (
              <figure class="mb-10 sm:mb-14 relative group -mx-5 sm:-mx-8 md:-mx-10 lg:-mx-12 -mt-5 sm:-mt-8 md:-mt-10 lg:-mt-12 overflow-hidden rounded-t-[1.5rem] sm:rounded-t-[2.5rem]">
                <img src={post.data.image} alt={post.data.title} class="w-full aspect-video md:aspect-[21/9] object-cover transition-transform duration-700 hover:scale-105" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/20 to-transparent pointer-events-none"></div>
              </figure>
            )}

            <!-- Tailwind Typography Overhaul with TEXT-JUSTIFY -->
            <div class="prose prose-lg md:prose-xl max-w-none 
                        prose-headings:font-black prose-headings:text-dark prose-headings:tracking-tight
                        prose-p:text-gray-700 prose-p:leading-relaxed prose-p:text-justify
                        prose-a:text-primary prose-a:font-semibold prose-a:no-underline hover:prose-a:text-primary-dark hover:prose-a:underline hover:prose-a:decoration-2 hover:prose-a:underline-offset-4
                        prose-img:rounded-[1.5rem] md:prose-img:rounded-3xl prose-img:shadow-lg prose-img:mx-auto prose-img:block
                        prose-blockquote:border-l-4 prose-blockquote:border-primary prose-blockquote:bg-gradient-to-r prose-blockquote:from-primary/5 prose-blockquote:to-transparent prose-blockquote:py-4 prose-blockquote:px-5 md:prose-blockquote:px-8 prose-blockquote:rounded-r-2xl prose-blockquote:italic prose-blockquote:text-gray-800 prose-blockquote:shadow-sm prose-blockquote:text-left
                        prose-table:w-full prose-table:overflow-hidden prose-table:rounded-2xl prose-table:shadow-sm prose-table:border prose-table:border-gray-200
                        prose-thead:bg-gray-50 prose-thead:border-b-2 prose-thead:border-gray-200 prose-th:p-3 md:prose-th:p-4 prose-th:text-left prose-th:text-gray-900 prose-th:font-black
                        prose-td:p-3 md:prose-td:p-4 prose-td:border-b prose-td:border-gray-100 align-middle
                        marker:text-primary"
                 id="article-content">
              <Content />
            </div>

            <!-- Scoped style to override @tailwindcss/typography defaults for list bullets -->
            <style is:global>
              #article-content p,
              #article-content li {
                text-align: justify !important;
              }
              #article-content ul {
                list-style: none !important;
                padding-left: 0 !important;
                text-align: left !important;
              }
              #article-content ul > li {
                position: relative !important;
                padding-left: 1.25rem !important;
              }
              #article-content ul > li::before {
                content: '✓' !important;
                position: absolute !important;
                left: 0 !important;
                color: #00A859 !important;
                font-weight: 700 !important;
                font-size: 1.1em !important;
              }

              /* Fix Sticky Header Overlap for Table Of Contents jumping */
              #article-content h1,
              #article-content h2,
              #article-content h3,
              #article-content h4,
              #article-content h5,
              #article-content h6 {
                scroll-margin-top: 120px !important;
              }

              /* H2 Blog Headers UI Overhaul: Bold Color Band */
              #article-content h2 {
                position: relative !important;
                font-size: 28px !important;
                margin-top: 3.5rem !important;
                margin-bottom: 1.5rem !important;
                line-height: 1.3 !important;
                padding: 0.75rem 1rem !important;
                border-left: 6px solid #00A859 !important;
                background: linear-gradient(to right, rgba(0, 168, 89, 0.15) 0%, transparent 100%) !important;
                border-top-right-radius: 1rem !important;
                border-bottom-right-radius: 1rem !important;
              }
              
              @media (min-width: 768px) {
                #article-content h2 {
                  font-size: 34px !important;
                  margin-top: 4rem !important;
                  margin-bottom: 2rem !important;
                  padding: 1rem 1.5rem !important;
                  border-left-width: 8px !important;
                  border-top-right-radius: 1.5rem !important;
                  border-bottom-right-radius: 1.5rem !important;
                  background: linear-gradient(to right, rgba(0, 168, 89, 0.1) 0%, transparent 100%) !important;
                }
              }

              /* Sub-headers H3 */
              #article-content h3 {
                font-size: 24px !important;
                margin-top: 2.5rem !important;
                color: #008744 !important; /* text-primary-dark */
              }

              @media (min-width: 768px) {
                #article-content h3 {
                  font-size: 26px !important;
                }
              }

              /* Image & Caption Overrides */
              #article-content figure {
                margin-top: 2.5rem !important;
                margin-bottom: 3rem !important;
                display: flex !important;
                flex-direction: column !important;
                align-items: center !important;
              }
              #article-content figure img {
                margin-bottom: 0.5rem !important;
                width: 100% !important;
              }
              #article-content figcaption {
                margin-top: 0 !important;
                font-size: 14px !important;
                font-style: italic !important;
                color: #6b7280 !important;
                text-align: center !important;
                line-height: 1.5 !important;
              }
            </style>

            <!-- Author & Share -->
            <div class="mt-20 pt-8 border-t border-gray-100 flex flex-col md:flex-row items-center justify-between gap-6">
              <div class="flex items-center gap-4">
                <img src="/images/branding/limo_green_final.png" alt="Cho Thuê Xe Tự Lái Hà Nội Avatar" class="w-14 h-14 rounded-full object-contain bg-dark p-1.5 shadow-md flex-shrink-0" />
                <div>
                  <div class="font-black text-dark text-lg md:text-xl">Cho Thuê Xe Tự Lái Hà Nội</div>
                  <div class="text-sm text-gray-500 font-medium">Chuyên gia Vận tải Cấp cao tại Hà Nội</div>
                </div>
              </div>
              <div class="flex gap-3 w-full md:w-auto">
                <button onclick="navigator.clipboard.writeText(window.location.href); alert('Đã copy link bài viết!');" class="flex-1 md:flex-none flex items-center justify-center gap-2 bg-gray-50 hover:bg-gray-100 border border-gray-200 text-dark font-bold px-6 py-3.5 rounded-xl transition-all hover:shadow-sm active:scale-95">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"></path></svg>
                  Chia Sẻ
                </button>
              </div>
            </div>

            <!-- CTA Box Inside Content -->
            <div class="mt-14 bg-gradient-to-br from-dark to-[#111827] rounded-3xl p-8 md:p-12 text-white relative overflow-hidden shadow-2xl">
              <div class="absolute top-0 right-0 w-80 h-80 bg-primary/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/3"></div>
              <div class="absolute bottom-0 left-0 w-64 h-64 bg-gold/10 rounded-full blur-3xl translate-y-1/3 -translate-x-1/4"></div>
              <div class="relative z-10 flex flex-col lg:flex-row items-center gap-8 text-center lg:text-left">
                <div class="w-24 h-24 rounded-3xl bg-gradient-to-tr from-primary to-green-400 flex flex-shrink-0 items-center justify-center shadow-[0_0_40px_rgba(0,168,89,0.4)] transform -rotate-6">
                  <svg class="w-12 h-12 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                </div>
                <div class="flex-1">
                  <div class="text-gold font-bold text-sm tracking-widest uppercase mb-2">Trải Nghiệm Chuẩn 5 Sao</div>
                  <h3 class="text-2xl md:text-3xl font-black mb-3 leading-tight">Sẵn sàng trải nghiệm dịch vụ VIP?</h3>
                  <p class="text-white/70 text-[16px] mb-8 max-w-lg mx-auto lg:mx-0">Liên hệ thuê xe dòng Limo Green đỉnh cao, không mùi, tĩnh lặng tuyệt đối cho lịch trình của bạn.</p>
                  <div class="flex flex-wrap justify-center lg:justify-start gap-4">
                    <a href="/lien-he/" class="bg-primary hover:bg-primary-dark text-white font-bold px-8 py-3.5 rounded-xl transition-all shadow-[0_4px_20px_rgba(0,168,89,0.3)] hover:shadow-[0_8px_30px_rgba(0,168,89,0.5)] hover:-translate-y-1 block w-full sm:w-auto">Tiến Hành Đặt Xe →</a>
                    <a href="tel:0979121097" class="bg-white/10 backdrop-blur-md border border-white/20 text-white font-bold px-8 py-3.5 rounded-xl hover:bg-white/20 transition-all block w-full sm:w-auto">📞 Gọi: 0979.121.097</a>
                  </div>
                </div>
              </div>
            </div>

          </div>

          <!-- RIGHT SIDEBAR: Recent Posts (20%) -->
          <aside class="hidden lg:block lg:col-span-1 space-y-8 sticky top-[120px]">
            {recentPosts.length > 0 && (
              <div class="bg-white/80 backdrop-blur-sm border border-gray-100 rounded-3xl p-6 shadow-sm">
                <h4 class="font-black text-dark text-base mb-6 flex items-center gap-2 border-b border-gray-100 pb-3">
                  <span class="w-6 h-6 rounded-full bg-gold/10 flex items-center justify-center">
                    <svg class="w-3 h-3 text-gold" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                  </span>
                  Bài Viết Mới
                </h4>
                <div class="space-y-6">
                  {recentPosts.map(rp => (
                    <a href={`/blog/${rp.slug}/`} class="group block">
                      {rp.data.image && (
                        <div class="rounded-xl overflow-hidden mb-3 relative shadow-sm">
                          <img src={rp.data.image} alt={rp.data.title} class="w-full aspect-[16/10] object-cover transform group-hover:scale-105 transition-transform duration-700" />
                          <div class="absolute inset-0 bg-black/10 group-hover:bg-transparent transition-colors"></div>
                        </div>
                      )}
                      <h5 class="font-bold text-[13px] text-dark group-hover:text-primary transition-colors leading-snug line-clamp-3">{rp.data.title}</h5>
                      <div class="text-[11px] text-gray-400 mt-1.5 font-medium">{new Date(rp.data.publishDate).toLocaleDateString('vi-VN', { year: 'numeric', month: 'long', day: 'numeric' })}</div>
                    </a>
                  ))}
                </div>
              </div>
            )}
          </aside>

        </div>
      </div>
    </article>
  </main>
</BaseLayout>
